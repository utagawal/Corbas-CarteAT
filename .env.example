# Copier en .env puis adapter.

# Port publié sur l'hôte (127.0.0.1 seulement, derrière nginx)
HOST_PORT=8085

# Clé de signature des sessions d'administration : `openssl rand -base64 48`
SECRET_KEY=change-moi

# Empreinte du mot de passe administrateur :
#   docker compose run --rm carteat python -m carteat.cli hash-password
# (la commande affiche la ligne complète, avec les « $$ » attendus par docker compose)
ADMIN_PASSWORD_HASH=

# URL publique (informative)
PUBLIC_URL=https://map.utagawavtt.com/ATCorbas/

# Sites autorisés à intégrer la carte en iframe
FRAME_ANCESTORS="'self' https://corbas.fr https://*.corbas.fr"

# Premier import : arrêtés publiés depuis cette année
START_YEAR=2026

# Heure de la synchronisation quotidienne (heure de Paris)
SYNC_HOUR=6
SYNC_MINUTE=15

# Fond de carte (style MapLibre)
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
